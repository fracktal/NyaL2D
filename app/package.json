{
  "name": "nyal2d-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NyaL2D: AI-native 2D puppet authoring environment (browser prototype on the Iki runtime)",
  "scripts": {
    "dev": "vite",
    "dev:mock": "NYAL2D_LLM_PROVIDER=mock vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vite build && node scripts/smoke.mjs",
    "mcp": "node server/mcp-bridge.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ikijs/editor": "0.12.1",
    "@ikijs/engine": "0.3.4",
    "@ikijs/format": "0.2.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "pretendard": "^1.3.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
